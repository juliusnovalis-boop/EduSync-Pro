# ────────────────────────────────────────────────────────────────────────────
# EduSync Pro — exemple de configuration (copiez ce fichier vers .env)
# ────────────────────────────────────────────────────────────────────────────
# ATTENTION : ne mettez JAMAIS vos vraies clés dans ce fichier.
# Copiez ce fichier vers .env puis remplissez vos valeurs.

# Base de données PostgreSQL — OBLIGATOIRE
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db


# Compte super administrateur (optionnel — valeurs par défaut ci-dessous si omis)
# SUPER_ADMIN_EMAIL=admin@edusync.ga
# SUPER_ADMIN_PASSWORD=admin26

# Secret de signature HMAC des sessions — RECOMMANDÉ en production (sinon dérivé de DATABASE_URL).
# Jamais exposé au navigateur. Changement → invalidation de toutes les sessions existantes.
# SESSION_SECRET=...

# Durées de session par rôle (centralisées) — configurables (optionnel)
# STUDENT / PARENT / TEACHER = 7 jours (fixe)
# ADMIN_SESSION_DAYS=2            # durée des sessions ADMIN (ex. 1 à 3 jours)
# SUPER_ADMIN_SESSION_HOURS=8     # durée courte des sessions SUPER_ADMIN (sécurité renforcée)

# ────────────────────────────────────────────────────────────────────────────
# Fournisseurs IA (EDUSYNC AI GATEWAY) — serveur uniquement, jamais côté client.
# ────────────────────────────────────────────────────────────────────────────

# Google Gemini Free — clé API (niveau gratuit uniquement, NE PAS activer la facturation)
GEMINI_API_KEY=

# Hugging Face — token (seuls les modèles GRATUITS seront utilisés)
HF_TOKEN=

# OpenRouter — clé API (uniquement les modèles du mécanisme openrouter/free)
OPENROUTER_API_KEY=

# ── Ollama Cloud (additif, FREE ONLY) — serveur uniquement ─────────────
# Clé API créée sur https://ollama.com → compte serveur, JAMAIS exposée au client.
# Sans clé : Ollama est ignoré automatiquement (pas de rupture). Sans modèle
# explicitement vérifié gratuit (voir ci-dessous) : BLOQUÉ par la politique EDUSYNC.
OLLAMA_API_KEY=
# Endpoint cloud (défaut officiel). Surtout, ne changez que pour un proxy interne.
OLLAMA_BASE_URL=https://ollama.com
# Catalogue des modèles Ollama par usage — alias pédagogique réel. Le client ne
# manipule jamais ces identifiants : il envoie un alias (education/reasoning/…),
# résolu côté serveur par src/lib/server/ai-models.ts.
# OLLAMA_MODEL_DEFAULT=gpt-oss:120b
# OLLAMA_MODEL_GENERAL=gpt-oss:120b
# OLLAMA_MODEL_EDUCATION=gpt-oss:20b
# OLLAMA_MODEL_REASONING=deepseek-v4-flash
# OLLAMA_MODEL_MATH=glm-5.2
# OLLAMA_MODEL_FALLBACK=gpt-oss:20b
# ⚠️ Preuve de gratuité — liste de modèles Ollama explicitement FREE VERIFIED
# par l'hébergeur (ex. plan incluant ces modèles), séparés par des virgules.
# Vide par défaut → tout modèle Ollama est BLOQUÉ (politique FREE ONLY stricte).
# Exemple : OLLAMA_FREE_VERIFIED_MODELS=gpt-oss:20b
# Plan du compte Ollama Cloud — confirmé UNIQUEMENT si renseigné explicitement :
# "free" → modèles du compte proposés en FREE_LIMITED ("Free plan / usage limité") ;
# "pro" ou vide → statut UNKNOWN : modèles accessibles mais JAMAIS "unlimited free".
# OLLAMA_PLAN=free

# ── Hugging Face — crédit gratuit (FREE ONLY) ────────────────────────────
# Crédit gratuit Inference Providers. Règle EduSync :
#   reste > 0  → autorisé jusqu'au plafond (FREE_LIMITED)
#   reste = 0  → BLOQUÉ
#   inconnu    → BLOQUÉ (JAMAIS de fallback payant)
# HF_FREE_CREDIT_LIMIT=0.10
# HF_FREE_CREDIT_REMAINING=

# Modèles texte par défaut (optionnel — valeurs par défaut si omis)
# GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
# HF_TEXT_MODEL=meta-llama/Llama-3.1-8B-Instruct:novita
# OPENROUTER_TEXT_MODEL=mistralai/mistral-7b-instruct:free

# ℹ️ Sans GEMINI_API_KEY ni HF_TOKEN, l'analyse IA utilise le moteur local déterministe,
#    et l'OCR / la dictée renvoient « fonctionnalité indisponible ». Le reste fonctionne.