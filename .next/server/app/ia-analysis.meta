{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/[[...all]]/layout,_N_T_/[[...all]]/page,_N_T_/ia-analysis"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/$oc$all/__PAGE__",
    "/$oc$all",
    "/_index",
    "/_head"
  ]
}